# Copy these values into your terminal environment before starting the server.
# Create a fresh random secret: python -c "import secrets; print(secrets.token_urlsafe(48))"
SMARTCROP_SECRET_KEY=replace-with-a-long-random-secret

# Optional: create an API key at https://data.gov.in/ to enable official mandi prices.
DATA_GOV_IN_API_KEY=

# OpenAI Responses API key for the SmartCrop agronomy assistant.
# Keep this key only in your local ignored .env file, never in frontend code or Git.
OPENAI_API_KEY=
# Optional: the current API guide uses gpt-6-astra as an example; change if your API project uses another model.
OPENAI_MODEL=gpt-6-astra
